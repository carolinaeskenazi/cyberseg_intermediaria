          ],
          "content": {
            "mimeType": "application/json; charset=utf-8",
            "size": 2831,
            "text": "{\"data\":{\"cashbackConfig\":{\"account\":{\"optInOffer\":{\"title\":\"que tal ter mais vantagens nas suas compras? 💰\",\"content\":\"participe e ganhe cashback nas suas compras. confira o <a href=\\\"http://www.youcom.com.br/cashback\\\" target=\\\"_blank\\\">regulamento</a>.\"},\"optInAccept\":{\"title\":\"eba! 🤩\",\"content\":\"vc está participando! agora é só fazer suas\\ncompras e aproveitar o benefício\"},\"optInReject\":{\"title\":\"que pena 😔\",\"content\":\"mas não se preocupe, caso mude de ideia vc pode participar do cashback entrando no menu\"},\"emptyBalance\":{\"title\":\"vc não tem saldo de cashback!\",\"content\":\"se vc está esperando um saldo de cashback aparecer aqui na página, o prazo para liberação do valor é de até ##VALUE## dias corridos após a confirmação da compra e nota fiscal emitida. se tá demorando mais do que o esperado, vc pode entrar em contato com nossa <a href=\\\"https://atendimento.youcom.com.br/hc/pt-br\\\"><b>central de atendimento.</b></a> :)\"},\"useTotalBalance\":{\"title\":\"account.useTotalBalance\",\"content\":\"pra usar todo o seu cashback sua compra precisa ser de pelo menos <b>R$ ##VALUE##</b>  <a href=\\\"https://www.youcom.com.br/cashback\\\" target=\\\"_blank\\\">*consulte condições</a>\"},\"alertWaitingCashback\":{\"title\":\"account.alertWaitingCashback\",\"content\":\"se vc está esperando um saldo de cashback aparecer aqui na tela, o prazo pra liberação do valor é de <b>até ##VALUE## dias</b> corridos após a confirmação da compra e nota fiscal emitida.\"}},\"cart\":{\"incentiveLogin\":{\"title\":\"cart.incentiveLogin\",\"content\":\"*faça login e ganhe cashback nas suas compras\"},\"useTotalBalance\":{\"title\":\"cart.useTotalBalance\",\"content\":\"faltam <b>R$ ##VALUE##</b> para vc usar todo o seu cashback. o valor do desconto é confirmado na etapa do pagamento. <font color=\\\"#666666\\\"><a href=\\\"http://www.youcom.com.br/cashback\\\" target=\\\"_blank\\\"><u>*consulte condições</u></a></font>\"}},\"checkout\":{\"banner\":{\"title\":\"comprou, ganhou cashback\",\"content\":\"seu bônus chega em até 3 dias corridos, após a confirmação da compra e nota fiscal emitida.\"},\"modal\":{\"title\":\"comprou, ganhou cashback\",\"content\":\"<p>uhu! esta compra vai gerar mais cashback pra vc! 😊</p>\\n<p>ele ficará disponível em 3 dias corridos, após a confirmação da compra e emissão da nota fiscal. </p>\\n<p>vc terá 60 dias corridos pra usar como desconto de até 10% numa próxima compra.</p>\\n<p>se quiser consultar seu extrato depois, vai em: <b>perfil > minha conta > cashback</b>.</p>\\n<p>pra saber mais, acesse o regulamento <a href=\\\"http://www.youcom.com.br/cashback\\\" target=\\\"_blank\\\">aqui</a>.</p>\"}},\"pdp\":{\"alert\":{\"title\":\"ganhe até R$ ##VALUE## de cashback\",\"content\":\"<a href=\\\"https://www.youcom.com.br/cashback\\\" target=\\\"_self\\\">*consulte condições</a>\"}},\"percent\":10,\"daysToBeAvailable\":3,\"enabled\":true}}}\n"
          },
          "redirectURL": "",
