o.save(\"horoscopo\",{selectedSign:e}):console.error(\"Failed to get GHint instance\")}},594(e){e.exports=React},206(e){e.exports=ReactDOM},433(e){e.exports=JSON.parse('{\"link1\":\"\",\"link2\":\"\",\"button1\":\"<p><a href=\\\\\"https://www.personare.com.br/horoscopo?utm_source=Parceiro&amp;utm_medium=Horoscopo%20etc&amp;utm_campaign=Horoscopo%20Botao%201&amp;ref=horoscopoetc\\\\\">Leia seu hor\\xf3scopo personalizado</a></p>\\\\n\",\"button2\":\"<p>Saiba tudo sobre os <a href=\\\\\"https://www.personare.com.br/signos?utm_source=Parceiro&amp;utm_medium=Horoscopo%20etc&amp;utm_campaign=Horoscopo%20Botao%202&amp;ref=horoscopoetc\\\\\">signos</a></p>\\\\n\",\"date\":\"2024-05-29T00:00:00-0300\",\"items\":[{\"type\":\"Amor\",\"typeSlug\":\"amor\",\"version\":\"Amor Exclusivo HETC\",\"versionSlug\":\"amor-exclusivo-hetc\",\"forecasts\":[{\"slug\":\"aries\",\"interval\":\"21/03 - 19/04\",\"label\":\"\\xc1ries\",\"content\":\"<p><span style=\\\\\"font-weight: 400;\\\\\">O c\\xe9u da semana desperta seu lado produtivo, contribuindo para revitalizar suas ambi\\xe7\\xf5es e sua vida profissional. Netuno ingressa em seu signo, inaugurando uma fase de maior intui\\xe7\\xe3o e frui\\xe7\\xe3o da sensibilidade.</span></p>\",\"link\":\"\"},{\"slug\":\"taurus\",\"interval\":\"20/04 - 20/05\",\"label\":\"Touro\",\"content\":\"<p>Evite situa\\xe7\\xf5es extremas entre voc\\xea e a pessoa amada. O melhor a fazer \\xe9 cuidar dos assuntos priorit\\xe1rios do relacionamento e fazer com que a vida afetiva entre nos eixos. Fa\\xe7a o poss\\xedvel para que seu amor se mantenha em alta neste dia de renova\\xe7\\xe3o. Seu romance exige empenho.</p>\\\\n\",\"link\":\"\"},{\"slug\":\"gemini\",\"interval\":\"21/05 - 20/06\",\"label\":\"G\\xeameos\",\"content\":\"<p>Passe a repensar suas atitudes e fa\\xe7a com que as diferen\\xe7as pessoais sejam trabalhadas. Lua, Merc\\xfario, Urano, J\\xfapiter, Sol e V\\xeanus exigem serenidade e seguran\\xe7a emocional para lidar com quaisquer situa\\xe7\\xf5es dif\\xedceis. E lembre-se: o amor \\xe9 mais importante que os desafios.</p>\\\\n\",\"link\":\"\"},{\"slug\":\"cancer\",\"interval\":\"21/06 - 22/07\",\"label\":\"C\\xe2ncer\",\"content\":\"<p>Passe a cultivar uma forma mais coerente de lidar com seu relacionamento. Os astros podem pesar o clima e, por isso, exigem uma postura afetiva cada vez mais generosa com a pessoa amada. Reflita sobre suas atitudes e fa\\xe7a com que elas estejam cada vez mais em dia com o romance.</p>\\\\n\",\"link\":\"\"},{\"slug\":\"leo\",\"interval\":\"23/07 - 22/08\",\"label\":\"Le\\xe3o\",\"content\":\"<p>Suas atitudes precisam ser revistas agora. Lua, Merc\\xfario, Urano, J\\xfapiter, Sol e V\\xeanus aventam o risco de voc\\xea se deixar levar pela ansiedade. Para que n\\xe3o haja problemas de comunica\\xe7\\xe3o ao longo do dia, cuide melhor da vida afetiva. \\xc9 hora de rever conceitos sobre o envolvimento.</p>\\\\n\",\"link\":\"\"},{\"slug\":\"virgo\",\"interval\":\"23/08 - 22/09\",\"label\":\"Virgem\",\"content\":\"<p>As for\\xe7as celestes questionam sua dedica\\xe7\\xe3o \\xe0 vida afetiva. Em vez de se render a qualquer dificuldade da rela\\xe7\\xe3o, entenda que os conflitos cotidianos devem ser revistos de maneira mais coerente. Reflita sobre suas atitudes e n\\xe3o permita que as dificuldades cotidianas lhe afastem da pessoa amada.</p>\\\\n\",\"link\":\"\"},{\"slug\":\"libra\",\"interval\":\"23/09 - 22/10\",\"label\":\"Libra\",\"content\":\"<p>\\xc9 favor\\xe1vel respeitar as peculiaridades do seu romance. Lua, Merc\\xfario, Urano, J\\xfapiter, Sol e V\\xeanus exigem de voc\\xea uma postura emocional mais coerente com o que voc\\xea acredita ser amor. Dedique-se mais \\xe0 pessoa amada e n\\xe3o deixe para depois o que pode ser resolvido.</p>\\\\n\",\"link\":\"\"},{\"slug\":\"scorpio\",\"interval\":\"23/10 - 21/11\",\"label\":\"Escorpi\\xe3o\",\"content\":\"<p>\\xc9 tempo de renovar os la\\xe7os que unem voc\\xea \\xe0 pessoa amada. As for\\xe7as celestes tendem a questionar a sua pr\\xf3pria tranquilidade afetiva. Demonstre coer\\xeancia emocional ao lidar com os sentimentos ou com os problemas cotidianos. N\\xe3o deixe que atritos lhe tirem do s\\xe9rio.</p>\\\\n\",\"link\":\"\"},{\"slug\":\"sagittarius\",\"interval\":\"22/11 - 21/12\",\"label\":\"Sagit\\xe1rio\",\"content\":\"<p>Atente \\xe0 necessidade de lidar bem com a sua vida afetiva. As for\\xe7as celestes apontam para os poss\\xedveis atritos com quem voc\\xea ama, por isso \\xe9 t\\xe3o necess\\xe1ria a seguran\\xe7a emocional para passar por algumas mudan\\xe7as que est\\xe3o ocorrendo em seu relacionamento.</p>\\\\n\",\"link\":\"\"},{\"slug\":\"capricorn\",\"interval\":\"22/12 - 19/01\",\"label\":\"Capric\\xf3rnio\",\"content\":\"<p>Entender melhor seu romance pode parecer um desafio bastante complicado, mas na verdade voc\\xea tem a chance de rever situa\\xe7\\xf5es negativas de maneira clara, sem tantos conflitos entre voc\\xea e sua cara-metade. O envolvimento amoroso tamb\\xe9m \\xe9 responsabilidade sua.</p>\\\\n\",\"link\":\"\"},{\"slug\":\"aquarius\",\"interval\":\"20/01 - 18/02\",\"label\":\"Aqu\\xe1rio\",\"content\":\"<p>Fa\\xe7a o poss\\xedvel para refletir melhor sobre o seu relacionamento e sobre como voc\\xea pode lidar com as situa\\xe7\\xf5es adversas. \\xc9 favor\\xe1vel manter o equil\\xedbrio emocional para que nada fuja ao seu controle. Invista tempo e cuidados aos seus sentimentos.</p>\\\\n\",\"link\":\"\"},{\"slug\":\"pisces\",\"interval\":\"19/02 - 20/03\",\"label\":\"Peixes\",\"content\":\"<p>O momento \\xe9 de agir com prud\\xeancia em nome do amor. Lua, Merc\\xfario, Urano, J\\xfapiter, Sol e V\\xeanus exigem autoconfian\\xe7a e dedica\\xe7\\xe3o ao romance. As dificuldades pessoais devem ser repensadas de modo sereno, sem tanta press\\xe3o. Procure manter a conviv\\xeancia afetiva em primeiro plano.</p>\\\\n\",\"link\":\"\"}]},{\"type\":\"Geral\",\"typeSlug\":\"geral\",\"version\":\"Geral Exclusivo HETC\",\"versionSlug\":\"geral-exclusivo-hetc\",\"forecasts\":[{\"slug\":\"aries\",\"interval\":\"21/03 - 19/04\",\"label\":\"\\xc1ries\",\"content\":\"<p><span style=\\\\\"font-weight: 400;\\\\\">O c\\xe9u da semana desperta seu lado produtivo, contribuindo para revitalizar suas ambi\\xe7\\xf5es e sua vida profissional. Netuno ingressa em seu signo, inaugurando uma fase de maior intui\\xe7\\xe3o e frui\\xe7\\xe3o da sensibilidade.</span></p>\",\"link\":\"\"},{\"slug\":\"taurus\",\"interval\":\"20/04 - 20/05\",\"label\":\"Touro\",\"content\":\"<p>Situa\\xe7\\xf5es imprevistas desestabilizam a viv\\xeancia do cotidiano, gerando inseguran\\xe7as quanto ao rumo dos acontecimentos, como alerta a tens\\xe3o lunar com Merc\\xfario, Urano, J\\xfapiter, Sol e V\\xeanus. Procure encarar as adversidades de modo objetivo e sereno, sem se deixar levar por ilus\\xf5es.</p>\\\\n\",\"link\":\"\"},{\"slug\":\"gemini\",\"interval\":\"21/05 - 20/06\",\"label\":\"G\\xeameos\",\"content\":\"<p>Os acontecimentos que v\\xeam impactando na vida em sociedade podem lhe levar a encarar a vida com apreens\\xe3o e de modo fatalista, dada a tens\\xe3o lunar com Merc\\xfario, Urano, J\\xfapiter, Sol e V\\xeanus. Procure cessar com as especula\\xe7\\xf5es sobre o que n\\xe3o pode ser controlado e exercite a resili\\xeancia.</p>\\\\n\",\"link\":\"\"},{\"slug\":\"cancer\",\"interval\":\"21/06 - 22/07\",\"label\":\"C\\xe2ncer\",\"content\":\"<p>Os aspectos tensos que conectam a Lua com Merc\\xfario, Urano, J\\xfapiter, Sol e V\\xeanus alertam para a import\\xe2ncia de estabelecer um programa de gastos e investimentos, evitando a\\xe7\\xf5es sem a devida an\\xe1lise de riscos. Preze pela disciplina e se cerque se estabilidade, fundamental ao equil\\xedbrio emotivo.</p>\\\\n\",\"link\":\"\"},{\"slug\":\"leo\",\"interval\":\"23/07 - 22/08\",\"label\":\"Le\\xe3o\",\"content\":\"<p>Instabilidade emotiva e excentricidades afloram na rela\\xe7\\xe3o com o entorno imediato, dificultando o conv\\xedvio, como alerta a tens\\xe3o lunar com Merc\\xfario, Urano, J\\xfapiter, Sol e V\\xeanus. Procure manter a mente aberta e respeitar as diferen\\xe7as, al\\xe9m de buscar acordos diplom\\xe1ticos na gest\\xe3o das demandas.</p>\\\\n\",\"link\":\"\"},{\"slug\":\"virgo\",\"interval\":\"23/08 - 22/09\",\"label\":\"Virgem\",\"content\":\"<p>O movimento da Lua se estressa com o de Merc\\xfario, Urano, J\\xfapiter, Sol e V\\xeanus, sugerindo dificuldades para lidar com os acontecimentos que lhe tiram da zona de conforto e lhe obrigam a se adaptar a novas demandas. As surpresas podem ser inc\\xf4modas, mas \\xe9 preciso encar\\xe1-las com coragem.</p>\\\\n\",\"link\":\"\"},{\"slug\":\"libra\",\"interval\":\"23/09 - 22/10\",\"label\":\"Libra\",\"content\":\"<p>O meio social se revela fator de grande dispers\\xe3o nessa fase, levando-lhe a cometer imprud\\xeancias que podem levar a preju\\xedzos de diversas ordens, como alerta a tens\\xe3o lunar com Merc\\xfario, Urano, J\\xfapiter, Sol e V\\xeanus. N\\xe3o se deixe influenciar e procure valorizar o c\\xedrculo de confian\\xe7a e intimidade.</p>\\\\n\",\"link\":\"\"},{\"slug\":\"scorpio\",\"interval\":\"23/10 - 21/11\",\"label\":\"Escorpi\\xe3o\",\"content\":\"<p>As rotinas sofrem uma reviravolta frente \\xe0 tens\\xe3o lunar com Merc\\xfario, Urano, J\\xfapiter, Sol e V\\xeanus, demandando capacidade de adapta\\xe7\\xe3o e mente aberta, ao inv\\xe9s de rea\\xe7\\xf5es defensivas. Encare as mudan\\xe7as como oportunidades de renova\\xe7\\xe3o e se mostre disposta a fazer as modifica\\xe7\\xf5es necess\\xe1rias.</p>\\\\n\",\"link\":\"\"},{\"slug\":\"sagittarius\",\"interval\":\"22/11 - 21/12\",\"label\":\"Sagit\\xe1rio\",\"content\":\"<p>A Lua segue tensionada a Merc\\xfario, Urano, J\\xfapiter, Sol e V\\xeanus, sugerindo um momento em que voc\\xea se v\\xea obrigada a adaptar seus planos a novos cen\\xe1rios, o que pode lhe render frustra\\xe7\\xf5es. Procure encarar as demandas de modo objetivo e pr\\xe1tico, mostrando-se colaborativa com o entorno imediato.</p>\\\\n\",\"link\":\"\"},{\"slug\":\"capricorn\",\"interval\":\"22/12 - 19/01\",\"label\":\"Capric\\xf3rnio\",\"content\":\"<p>Extravag\\xe2ncias no uso de dinheiro podem lhe deixar em situa\\xe7\\xe3o dif\\xedcil, impactando na qualidade de vida de curto a longo prazo, como alerta a tens\\xe3o lunar com Merc\\xfario, Urano, J\\xfapiter, Sol e V\\xeanus. Contenha seus impulsos e se discipline, priorizando o que se revela altamente necess\\xe1rio.</p>\\\\n\",\"link\":\"\"},{\"slug\":\"aquarius\",\"interval\":\"20/01 - 18/02\",\"label\":\"Aqu\\xe1rio\",\"content\":\"<p>Os interesses individuais tendem a contrastar sensivelmente com os coletivos nesse momento de tens\\xe3o lunar com Merc\\xfario, Urano, J\\xfapiter, Sol e V\\xeanus, o que requer maior capacidade diplom\\xe1tica. Siga fiel \\xe0s suas prioridades, mas avalie a possibilidade de fazer concess\\xf5es em prol de suas rela\\xe7\\xf5es.</p>\\\\n\",\"link\":\"\"},{\"slug\":\"pisces\",\"interval\":\"19/02 - 20/03\",\"label\":\"Peixes\",\"content\":\"<p>As demandas dom\\xe9sticas tendem a se mostrar desgastantes frente \\xe0 tens\\xe3o lunar com Merc\\xfario, Urano, J\\xfapiter, Sol e V\\xeanus, pedindo serenidade e capacidade de adapta\\xe7\\xe3o, al\\xe9m de uma articula\\xe7\\xe3o diplom\\xe1tica com o entorno para o compartilhamento de responsabilidades. Evite sobrecarga.</p>\\\\n\",\"link\":\"\"}]}]}')}};const o={};function a(t){const r=o[t];if(void 0!==r)return r.exports;const s=o[t]={exports:{}};return e[t](s,s.exports,a),s.exports}a.r=e=>{Symbol.toStringTag&&Object.defineProperty(e,Symbol.toStringTag,{value:\"Module\"}),Object.defineProperty(e,\"__esModule\",{value:!0})};(()=>{const e=a(848),o=(a(594),n(a(206))),t=n(a(458)),r=a(576),s=a(46);function n(e){return e&&e.__esModule?e:{default:e}}a(163);document.querySelectorAll(\"#widget-horoscopo\").forEach(async a=>{try{const n=await(0,r.getHoroscopeData)(a);if((0,s.isLocalhost)()){a.innerHTML=\"\"}o.default.render((0,e.jsx)(t.default,{items:n}),a),function(e){const o=win